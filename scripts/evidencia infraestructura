#!/usr/bin/env bash
# Ejecutar en: cualquier Linux de la practica (guarda salida en archivo)
# Uso: ./07-evidencias-infraestructura.sh > evidencia-$(hostname).txt
source "$(dirname "$0")/config.env"
echo "### Host: $(hostname)  Fecha: $(date)"
echo "### Interfaces"; ip -br a
echo "### Rutas";      ip route
echo "### ARP";        ip neigh
for h in "$GW_USUARIOS" "$ISP_FORTI" "$FORTI_WAN" "$SERVIDOR"; do
  ping -c 2 -W 2 "$h" > /dev/null 2>&1 && echo "PING $h OK" || echo "PING $h FAIL"
done
echo "### Traceroute a $SERVIDOR"; traceroute -n "$SERVIDOR" 2>/dev/null
 
